# ══════════════════════════════════════════════
# V15Plus 环境变量示例
# 复制为 .env 或直接 export；切勿提交真实密钥
# ══════════════════════════════════════════════

# ── 数据源（最重要的配置！）──
# 通达信安装目录 —— 日线/板块数据的来源。填"包含 vipdoc 子目录"的那一层。
# 例：D:\通达信 或 C:\new_tdx  （详见 docs/DATASOURCE.md）
TDX_ROOT_PATH=D:\通达信

# ── AI 分析（DeepSeek）──
DEEPSEEK_KEY=
# 亦可使用 DEEPSEEK_KEY1 / DEEPSEEK_KEY2 / DEEPSEEK_KEY3 多 key 轮换

# ── 云服务器（Hybrid Research / market-bot）──
CLOUD_URL=http://your-server.example.com/research
CLOUD_HOST=your-server.example.com
CLOUD_USER=ubuntu
CLOUD_PASSWORD=
CLOUD_SSH_KEY=~/.ssh/id_ed25519
CLOUD_MARKETBOT_DIR=/home/ubuntu/market-bot
CLOUD_REMOTE_DIR=/home/ubuntu/hybrid-research
MARKETBOT_URL=http://your-server.example.com/api/v1/market-data
HYBRID_HMAC_SECRET=
HYBRID_PORT=8001
APP_ENV=production

# ── 飞书机器人推送 ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# ── 企业微信 ──
WECHAT_TOKEN=
